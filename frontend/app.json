{
  "expo": {
    "name": "GeoInsight",
    "slug": "geoinsight",
    "scheme": "geoinsight",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geoinsight.geoinsight"
    },
    "android": {
      "package": "com.geoinsight.geoinsight",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "updates": {
      "enabled": false
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
